# papervault configuration — copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# === LLM provider (OpenAI-compatible) — REQUIRED ===========================
# papervault routes graph build, search triage, and answer synthesis to ONE
# OpenAI-compatible endpoint. Supply keys one of three ways:
#
#  (a) Simple: a single key + base URL below.
#  (b) Scale: a JSON key-pool file (PAPERVAULT_LLM_KEYS) — an array of
#      {"model": ..., "api_key": ..., "base_url": ...} groups with per-request
#      random failover and 401 auto-disable. The pool takes precedence.
#  (c) Gateway: enable PAPERVAULT_LLM_GATEWAY and supply its key below;
#      direct credentials above are not required in that mode.
PAPERVAULT_LLM_API_KEY=
PAPERVAULT_LLM_BASE_URL=http://127.0.0.1:4000/v1
# PaperVault sends concrete model IDs + per-role thinking/effort wire parameters
# directly to the OpenAI-compatible endpoint or transparent LLM Gateway.
# Optional multi-key pool file (see above). Default: <data>/llm_keys.json
#PAPERVAULT_LLM_KEYS=/path/to/llm_keys.json

# === Per-role LLM routes (optional; ADR-0012 / ADR-0013) ===================
# Format: <model>[@<modifier>][,<fallback>...] (Gateway v0.7.3 per-family rules)
#   - glm-* / relay-glm-*: bare or @low, @high, @max (always-on thinking; @none/@nothinking rejected).
#   - gpt-6-astra* / gpt-6.1-sol*: bare or @low, @medium, @high, @xhigh, @max (@none rejected).
#   - gpt-6.1-terra* / gpt-6-luna*: bare or @none, @low, @medium, @high, @xhigh, @max.
#   - deepseek-v4* / deepseek-flash* / relay-deepseek-*: bare, @low, @high, @max, or @nothinking (@none).
#   - mimo-v2.6-* / relay-mimo-v2.6-*: bare, @thinking, or @nothinking (@none) (effort tiers rejected).
#   - Other OpenAI-compatible model IDs: bare, @none..@max, or @thinking / @nothinking.
#   - Multi-target comma chains fail over immediately on transient primary errors
#     (429, 408, 5xx, timeout, StreamTruncated) and skip the cooled-down primary
#     for PAPERVAULT_LLM_FALLBACK_COOLDOWN_S seconds before re-probing.
#   - Retired aliases (flash / standard / pro / max / ultra / papervault-*) fail
#     loudly at startup and in `papervault doctor`.
# S1: intent -> API search_terms + canonical local kg_concepts (one call);
# judge -> ingest/domain + return relevance gates and fuzzy get_paper resolution;
# verify -> downloaded PDF identity; gate -> OCR chunk clarity + document completeness.
# S2: build -> entity/relation extraction + merge summaries; keyword -> query keywords
# when not supplied; decompose -> facets + source-count/fan-out planning;
# synth -> evidence-grounded answer. eval_judge -> single-target cross-family judge
# preserving the benchmark ruler invariant (optional same-family override:
# PAPERVAULT_LLM_EVAL_JUDGE=glm-5.3@max,relay-glm-5.3@max).
#PAPERVAULT_LLM_INTENT=gpt-6.1-terra@high
#PAPERVAULT_LLM_BUILD=glm-5.3@max,gpt-6.1-terra@high
#PAPERVAULT_LLM_KEYWORD=gpt-6.1-terra@low
#PAPERVAULT_LLM_SYNTH=gpt-6-astra@xhigh
#PAPERVAULT_LLM_GATE=glm-5.3-flash@high,gpt-6.1-terra@medium
#PAPERVAULT_LLM_VERIFY=glm-5.3-flash@low,gpt-6.1-terra@low
#PAPERVAULT_LLM_JUDGE=gpt-6.1-terra@medium
#PAPERVAULT_LLM_DECOMPOSE=gpt-6.1-terra@high
#PAPERVAULT_LLM_EVAL_JUDGE=glm-5.3@max
# Primary-model cooldown window (seconds) after transient multi-target failover (<= 0 disables).
#PAPERVAULT_LLM_FALLBACK_COOLDOWN_S=120
# Retired: PAPERVAULT_MODEL, PAPERVAULT_BUILD_MODEL, KS_BUILD_MODEL,
# PAPER_PIPELINE_VERIFY_MODEL, MIMO_MODEL. Migrate to the role variables above.

# Optional: route through a local LiteLLM proxy instead (advanced; default off).
#PAPERVAULT_LLM_GATEWAY=1
#PAPERVAULT_LLM_GATEWAY_URL=http://127.0.0.1:4000/v1
#PAPERVAULT_LLM_GATEWAY_KEY=

# === MCP server transport (unified `papervault serve`) =====================
# `papervault serve` binds loopback (127.0.0.1:8080) with NO auth by default —
# keep it on loopback / a trusted VPN address. To require auth (e.g. when binding
# a non-loopback host), set a token: the HTTP transport then rejects any request
# without `Authorization: Bearer <token>` (401 JSON). Unset ⇒ no auth (unchanged);
# the --stdio transport is never affected.
#PAPERVAULT_MCP_TOKEN=
# Extra allowed Host headers for reverse proxies; unset/empty keeps loopback only.
# Comma-separated: exact host:port, bare host, or host:* (any explicit port).
# Whitespace and empty entries are ignored; loopback remains allowed.
# On the default 443 port write the bare hostname; host:* does not match a port-less Host.
#PAPERVAULT_MCP_ALLOWED_HOSTS=node.example.ts.net:8080

# === LLM timeouts (raise these for a slow endpoint) ========================
# Per-extraction-call deadline (s); LightRAG's per-worker cap is derived as 2x this.
#KS_LLM_TIMEOUT=240
# Answer-synthesis business deadline (s).
#KS_SYNTH_TIMEOUT_S=840
# Query-decomposition deadline (s).
#KS_DECOMPOSE_TIMEOUT_S=300
# Transport-level dead-connection catch (s); must exceed the deadlines above.
#KS_LLM_CLIENT_TIMEOUT=900
# Completions are STREAMED and re-joined (default 1): a relay may close any request that is
# silent for ~120 s, which a long extraction chunk is. Set 0 to go back to plain calls.
#KS_LLM_STREAM=1
# Gateway path: retry TRANSIENT failures (a cut stream, a transport timeout, 408/429, 5xx) this
# many times with jittered backoff (cap in s). A retry is only STARTED while there is still room
# for it inside the budget (s, an absolute deadline from the first attempt; defaults to LightRAG's
# per-worker cap = 2 x KS_LLM_TIMEOUT, i.e. 480 when that is unset). For a transport timeout to be
# retriable, keep KS_LLM_CLIENT_TIMEOUT below the budget minus any positive KS_LLM_FIRST_CHUNK_S
# (e.g. 1500 with KS_LLM_TIMEOUT=900). Other (deterministic) 4xx are never retried.
#KS_GATEWAY_TRANSIENT_RETRIES=2
#KS_GATEWAY_TRANSIENT_BACKOFF_CAP=15
#KS_GATEWAY_RETRY_BUDGET_S=480
# Optional pre-first-chunk cutoff (s), counted from sending the request through the first stream
# chunk on both direct and gateway paths. Default 0 (disabled; outer client/caller timeouts govern
# while reasoning models think before emitting tokens). Set a positive value only behind a relay
# with a short silent-TCP idle drop.
#KS_LLM_FIRST_CHUNK_S=0

# === Data layout ===========================================================
# One base dir holds the vault, knowledge store, and (default) key file.
PAPERVAULT_DATA=~/.local/share/papervault
## NOTE: a pre-existing PAPER_LIBRARY_PATH env (legacy) is honored as a fallback and
# overrides the default vault location — set PAPERVAULT_VAULT to be explicit.
PAPERVAULT_VAULT=${PAPERVAULT_DATA}/vault
#PAPERVAULT_STORAGE=${PAPERVAULT_DATA}/knowledge_store

# === Domain pack ===========================================================
# Factory default is the bundled 'space_physics' pack. Select another bundled
# pack by name, or point PAPERVAULT_DOMAIN_PATH at an external pack directory
# carrying the same files (domain.toml, ontology.json, extraction_examples.txt,
# extraction_exclusions.txt, search_gate.md).
#PAPERVAULT_DOMAIN=space_physics
#PAPERVAULT_DOMAIN_PATH=/path/to/your/pack

# === Databases (knowledge graph backing stores) ============================
# NOTE: keep POSTGRES_USER / POSTGRES_DB set — treat them as REQUIRED. The code's
# built-in fallbacks differ from the docker-compose container (which creates
# user/db 'papervault'), so leaving them unset can let `papervault doctor` pass
# against one database while the runtime targets a different, nonexistent one.
# Keep these matching deploy/docker-compose.yml.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=papervault
POSTGRES_PASSWORD=changeme
POSTGRES_DB=papervault
# If 7474/7687 are taken, set these AND update NEO4J_URI's port to match NEO4J_BOLT_PORT.
# NEO4J_HTTP_PORT=7474
# NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme
# Workspace isolation (prod-safety gate). Both MUST match and be non-empty.
NEO4J_WORKSPACE=main
POSTGRES_WORKSPACE=main
# S1 dual-track local retrieval: BM25 + PGVector chunks/entities/relations +
# Neo4j cross-facet topology/high-weight hub edges + authority, fused before LIB_CAP=45.
# KG ranks also contribute to search fusion; API/BM25 terms keep their existing meaning.
# KG defaults on only when PAPERVAULT_STORAGE_BACKEND=postgres; otherwise defaults off.
# Explicit 1 enables; 0 disables. Uses the knowledge POSTGRES_* DB (not the catalog DSN),
# matching workspace and NEO4J_* credentials above, and the in-process BGE-M3 model.
# PG uses read-only transactions + hnsw.ef_search=120; Neo4j uses read sessions.
# Unset NEO4J_DATABASE tries LightRAG's chunk-entity-relation, then the home DB
# only on DatabaseNotFound. Encoding shares S2 GPU admission, releasing before DB reads.
# Unconfigured/unavailable stores or embeddings fail open to BM25/external search.
#PAPERVAULT_SEARCH_KG=1
# The workspace name 'l0' is RESERVED as a production namespace and is refused
# unless KS_ALLOW_PROD_WORKSPACE=1 is set on purpose. Use any other name for
# dev/test instances.
#KS_ALLOW_PROD_WORKSPACE=1

# === Knowledge auto-ingest scheduler =======================================
# The distillation loop (reconcile -> diff -> distill -> graph build) that turns
# newly downloaded papers into query()-able knowledge. Default OFF (opt-in): the
# advertised 'search -> queryable in tens of minutes' loop DOES NOT run until you
# enable this. Enable it once your corpus/vault is populated.
KS_AUTO_INGEST_ENABLED=false
# Seconds between scheduler rounds (default 60).
#KS_AUTO_INGEST_INTERVAL_SEC=60
# REDISTILL circuit-breaker (#84): consecutive build failures for one paper before it is PARKED
# (ledger status→error_parked, no longer auto re-distilled) instead of being re-distilled +
# re-removed (graph churn) every round forever on a systemic build break. Default 3. A parked key
# is revived only by an explicit force re-ingest or a content/fingerprint change. Set <=0 to
# disable parking (pre-#84 behavior: retry an 'error' key every round indefinitely).
#KS_REDISTILL_MAX_ATTEMPTS=3
# Build-path breaker (#143): when this many build-role LLM calls (LightRAG extraction/merge) fail
# upstream (HTTP 4xx/5xx from the gateway, transport errors — not cancellations) within the window
# (s), the background build PAUSES for the cool-down (s): build calls fail fast without contacting
# the gateway and scheduler rounds start no new build work. Then one probe round runs; success
# resumes the build, failure pauses it again. The query path (query/search/get_paper, including its
# keyword call) is never paused. One log line per transition. FAILURES<=0 disables it.
#KS_BUILD_BREAKER_FAILURES=30
#KS_BUILD_BREAKER_WINDOW_S=300
#KS_BUILD_BREAKER_COOLDOWN_S=600
# Abstract-only docs (#144, #148): without an extract, metadata_only / extract_failed / failed
# papers with a non-empty abstract enter the graph
# as ONE doc (title/authors/year/venue/ids/abstract, headed "[ABSTRACT ONLY — full text not
# available]"), ledger status done_abstract, labelled abstract-only in synthesis and in query's
# abstract_only_papers. Full text, when it arrives, replaces it. Default ON. Set =0 to stop: the
# next rounds delete those docs and return the rows to done_meta (or do it at once, service
# stopped: `python -m papervault.knowledge.cli rollback-abstracts --apply`).
#KS_ABSTRACT_DOCS=1
# Boot embedding probe timeout (s), default 60. Scheduler stays off on failure/timeout.
#KS_EMBED_SELFCHECK_TIMEOUT_SEC=60
# Retry a failed/timed-out boot probe without needing a client. Default 60s; clamped to
# 1..300s to prevent spinning or indefinite postponement. One probe stays in flight across
# timeouts because native GPU work cannot be cancelled.
#KS_EMBED_SELFCHECK_RETRY_SEC=60
# Startup waits this long for scheduler initialization, then serves while it retries.
#KS_STARTUP_AWAIT_SEC=3
# Diagnostic bypass of the GPU embedding boot probe (does not prove GPU readiness).
#KS_SKIP_EMBED_SELFCHECK=0
# Progress-heartbeat interval (s) for long query() calls — keeps MCP clients from
# aborting on their own idle timeout. Default 45; set <=0 to disable.
#KS_PROGRESS_HEARTBEAT_S=45

# === Operator-supplied upstreams (`papervault ingest-doc`) =================
# Documents the OPERATOR brings by hand — canonical textbooks/major reviews (#45) and
# the lab's own executor notebooks (#47) — entering the graph OUTSIDE the paper pipeline
# with typed provenance (textbook:AuthorYear / notebook:<idea>-<scope>). BOTH default OFF.
# Textbooks: operator-supplied canonical sources, gated for beta safety.
#PAPERVAULT_OPERATOR_SOURCES=0
# Notebooks: UNPUBLISHED research — PRIVATE-INSTANCE ONLY. A shared/beta instance must
# NEVER ingest notebooks (it would leak the lab's private reasoning into a distributable
# knowledge base). Set =1 only on an instance you fully control and never redistribute.
#PAPERVAULT_PRIVATE_SOURCES=0
# Max tokens per ingested section (heading-aware cap; LightRAG re-chunks each section).
#PAPERVAULT_DOC_MAX_TOKENS=2400
# ingest-doc is a MAINTENANCE-WINDOW op: it writes the ledger + graph the live service
# serves, so it REFUSES to run while papervault.service (or the MinerU unit) is active
# (DB co-write corruption). Stop the service first, or set =1 to override deliberately.
#KS_INGEST_ALLOW_COTENANCY=0
# Windowless in-service drain (#81): an operator DROPS textbook-<Key>.pdf / .md files into
# this dir and the live scheduler's serial loop picks them up (no maintenance window).
#KS_OPDOC_PENDING_DIR=/data/paper-vault/operator-drop/pending
# Corrupt-PDF drain-stall backstop (#89). Hard wall-clock cap (seconds) on ONE operator-doc OCR
# call, threaded into MinerU as a deadline so a corrupt/pathological PDF can never stall the
# serial drain indefinitely. Primary defence is the cheap pre-OCR structural probe (a valid
# %PDF header hiding a broken xref/trailer → routed to failed/ without OCR); this only bounds a
# probe MISS or a server-side hang. Default 30 min (paper-extract-ceiling parity). Set <=0 to
# DISABLE the total deadline (escape hatch for larger documents). Individual HTTP requests
# still time out, but successful pending/processing polls can continue without a total cap.
#KS_OPDOC_OCR_TIMEOUT_SEC=1800

# === Evaluation (standalone process; service-stopped maintenance window) ===
# Eval requires matching l0_probe workspaces, or read-only l0 with explicit
# KS_ALLOW_PROD_WORKSPACE=1. It refuses while guarded service units are active.
# Deliberate co-tenancy override (GPU budget + corpus freeze remain operator-owned):
#KS_EVAL_ALLOW_COTENANCY=1
# Raw results and filled judge prompts live outside source; see docs/eval.md.
#PAPERVAULT_EVAL_DIR=/data/paper-vault/eval-results

# === Query retrieval / synthesis (benchmark-arbitrated; docs/eval.md) =======
# Production and run_eval share these settings. Restart processes after changes.
#KS_QUERY_VARIANT=multiquery
#KS_TOP_K=100
#KS_CHUNK_TOP_K=60
#KS_MAX_TOTAL_TOKENS=300000
#KS_MQ_N_SUBQ=5
#KS_MQ_RRF_K=60
#KS_MQ_SUB_CHUNK_TOP_K=60
#KS_MQ_ENABLE_RERANK=true
#KS_RERANK_POOL_CAP=120
#KS_MQ_MAX_CHUNKS_PER_PAPER=0
#KS_MQ_MIN_COVERAGE=thin
# Optional legacy keyword-prompt experiment; default uses the stock prompt.
#KS_KW_PROMPT_COMPAT=0
#KS_MQ_CITATION_PRIOR=0
#KS_MQ_CITATION_LAMBDA=0.5
#KS_MQ_FANOUT=1
#KS_MQ_FANOUT_MAX=100
#KS_MQ_FANOUT_SLOPE=7
#KS_SYNTH_STRICT_REFUSAL=1
#KS_SYNTH_COVERAGE=0
#KS_SYNTH_MAX_RETRIES=2
#KS_SYNTH_BACKOFF_BASE=2.0
# Optional citation map: KS_CITATION_MAP overrides PAPERVAULT_CITATION_MAP.
#PAPERVAULT_CITATION_MAP=${PAPERVAULT_DATA}/citation_map.json

# === GPU / local models ====================================================
# The embed + reranker run in-process on the GPU; OCR (MinerU) is a co-tenant.
CUDA_VISIBLE_DEVICES=0
BGE_M3_DEVICE=cuda:0
BGE_RERANKER_DEVICE=cuda:0
# Local paths for the embed + reranker checkpoints (default: download from HF).
# Point these at a local directory for offline / air-gapped installs.
#BGE_M3_MODEL_PATH=BAAI/bge-m3
#BGE_RERANKER_MODEL_PATH=BAAI/bge-reranker-v2-m3
# fp16 reranker (3.8x faster, recall sub-noise-floor). float32 to revert.
# (KS_RERANK_DTYPE keeps its legacy KS_ name for back-compat — no PAPERVAULT_ alias.)
KS_RERANK_DTYPE=float16
# Reranker VRAM/latency levers (query-path peak). batch_size is the dominant VRAM
# lever and is quality-neutral: lower it when co-renting the GPU with OCR.
#   32 @ max_length 4096 ~= 16.6 GB; 8 ~= a quarter of that.
KS_RERANK_BATCH_SIZE=8
# Concurrent GPU rerank calls (default 1 = serialize on the shared card).
#KS_RERANK_MAX_ASYNC=1
# Per-chunk rerank token cap (default 4096 = never truncate the ~2750-tok chunks).
#KS_RERANK_MAX_LENGTH=4096
# LightRAG's own rerank worker timeout (s). papervault defaults this to 480 (upstream
# default 30 silently DROPS reranking under co-rented-GPU contention — recall killer).
#RERANK_TIMEOUT=480

# === Graph-build concurrency (throughput + build-time VRAM) ================
# LLM extraction fan-out; scale roughly with the number of active LLM keys.
#KS_LLM_MAX_ASYNC=32
# Documents inserted in parallel (raise for throughput on a fast endpoint).
#KS_MAX_PARALLEL_INSERT=16
# Concurrent embedding calls — a build-time GPU VRAM lever; lower when co-renting.
#KS_EMBED_MAX_ASYNC=16
# Physical GPU embedding forward passes; independent of the build-call queue above.
#KS_EMBED_GPU_MAX_ASYNC=1
# Run embedding in a worker thread to keep the MCP loop responsive (default on).
#KS_EMBED_OFFLOAD=1

# === OCR (shared MinerU HTTP task service) =================================
# papervault uses core httpx to submit whole PDFs to standalone mineru-service
# (official mineru-api). Provision it SEPARATELY; the 'mineru' extra is empty.
# POST /tasks -> GET /tasks/{id} -> GET /tasks/{id}/result; page rendering and
# inference happen in the service. See docs/INSTALL.md. Comma-separated URLs
# enable endpoint failover; the default is the local service on port 30000.
#MINERU_URL=http://127.0.0.1:30000
# Connection-pool limits for the httpx client owned by ONE endpoint attempt.
# MAX_CONCURRENCY retains its name but now sets the keepalive connection ceiling
#   (clamped to MAX_CONNECTIONS). It does not control parallel documents or the
#   service's FIFO processing concurrency. Requests within one task are sequential.
# MAX_CONNECTIONS bounds that client's total connections; concurrent attempts
#   have separate clients. Each client closes on completion or cancellation.
#PAPER_LIBRARY_MINERU_MAX_CONCURRENCY=32
#PAPER_LIBRARY_MINERU_MAX_CONNECTIONS=64
# After each extraction the client calls glibc malloc_trim(0) to return freed
# heap memory to the OS (no-op off glibc). 0 disables this best-effort cleanup.
#PAPER_LIBRARY_MINERU_MALLOC_TRIM=1

# === MinerU service boundary ==============================================
# The shared service owns AsyncTaskManager FIFO queuing, --enable-vlm-preload true,
# and GPU unloading after 20 idle minutes, plus backend wakeup and recovery.
# No caller pre-flight: submit/poll/result errors determine reachability.
# Pending queue-wait timeouts defer without charging an extraction attempt;
# active-processing read/wall-clock timeouts charge an attempt. Connection and
# service outages remain transport failures. See docs/INSTALL.md. Caller lifecycle
# switches, warmup/restart settings, PRECHECK and PRECHECK_TIMEOUT are retired.

# === BGE model idle release ================================================
# Opt-in: after no embed or rerank inference for 600 s, release BOTH in-process
# models and their CUDA cache. The next call reloads the model it needs.
#KS_BGE_IDLE_UNLOAD=1
#KS_BGE_IDLE_TIMEOUT=600

# === OCR / extract queue concurrency =======================================
# Whole-PDF OCR tasks admitted concurrently by this caller (the shared service
# owns FIFO processing across all callers).
#PAPER_LIBRARY_EXTRACT_CONCURRENCY=8
# Worker-pool size; MUST be >= EXTRACT_CONCURRENCY so workers in their post-OCR
# LLM-gate phase don't starve the GPU of OCR work.
#PAPER_LIBRARY_EXTRACT_WORKERS=16
# Concurrent post-OCR LLM clarity/completeness gate calls (bounds LLM 429s).
#PAPER_LIBRARY_GATE_CONCURRENCY=8

# === Scholarly-API contact (polite pool) ===================================
# Used as the Crossref/OpenAlex User-Agent mailto on the metadata-fetch path.
# Use an address you own; the download cascade reads the separate contact vars below.
PAPERVAULT_CONTACT_EMAIL=you@example.org
# Download-cascade credentials — set the contact vars to an address you own.
# hal_repository (HAL/HAL-INSU) needs no credentials; exact DOI lookup, at most
# one request per second including file redirects, with HTTP 429 cooldowns.
# Variable | Tier / what it unlocks | When unset
# UNPAYWALL_EMAIL | oa_aggregators / Unpaywall OA locations | Requests still run with the invalid contact research@example.invalid.
# UNPAYWALL_EMAIL | crossref_tm / publisher TDM PDF links | Requests still run with research@example.invalid as mailto.
# OPENALEX_MAILTO | oa_aggregators / OpenAlex OA locations | Requests still run with research@example.invalid as mailto.
# OpenAlex resolves stored work IDs as well as DOIs, then follows bounded public
# repository locations and explicit PDF links. No API key is sent. Authenticated,
# metered content.openalex.org downloads are disabled, including linked/redirected URLs.
# CORE_API_KEY | oa_aggregators / CORE repository PDFs | CORE skips before network; the other group members still run.
# ADS_API_TOKEN | domain_aggregators / NASA ADS PDFs (DOI, arXiv or validated stored ADS URL/bibcode) | ADS skips before network; the other group members still run.
# WILEY_TDM_TOKEN | wiley_tdm / Wiley and AGU PDF API (free academic registration) | Tier skips before network (download_skip: missing_credentials).
# ELSEVIER_TDM_API_KEY | elsevier_tdm / Elsevier PDF API (institutional subscription) | Tier skips before network (download_skip: missing_credentials).
# ANNAS_ARCHIVE_API_KEY | annas_archive / member PDF lookup and downloads (active membership required) | Tier skips before network (download_skip: missing_credentials).
# FIRECRAWL_API_KEY | firecrawl / publisher-page markdown fallback | Cloud fallback skips before network; URLs starting with http:// or containing localhost or 127.0.0.1 need no key.
#UNPAYWALL_EMAIL=
#OPENALEX_MAILTO=
# Semantic Scholar API authentication (optional; unset keeps keyless requests).
#SEMANTIC_SCHOLAR_API_KEY=
#ADS_API_TOKEN=
#CORE_API_KEY=
#WILEY_TDM_TOKEN=
#ELSEVIER_TDM_API_KEY=
#FIRECRAWL_API_KEY=
# FIRECRAWL_API_URL defaults to the cloud URL below when unset; set your self-hosted URL here.
#FIRECRAWL_API_URL=https://api.firecrawl.dev

# === Library search / download knobs =======================================
# Default number of papers search_papers returns when the query names no count.
#PAPER_SEARCH_DEFAULT_LIMIT=15
# Search authority prior: local BM25/RRF fusion pool selection AND final
# by_relevance ordering. Citation velocity x domain-aware venue/DOI tiers
# (1.5x/1.2x/1.0x/0.5x); explicit recency/importance bypasses both priors.
# Exact 1 enables (default); 0 disables. Never admits a quality-gate reject.
#PAPERVAULT_SEARCH_AUTHORITY_PRIOR=1
# Shared authority_weight/lambda for fusion and final RRF; 0 removes added RRF
# terms. Base relevance ordering retains authority after score/external ties.
# Non-numeric uses 0.25; out-of-range clamps to [0,1], with warnings.
#PAPERVAULT_SEARCH_AUTHORITY_LAMBDA=0.25
# Comma-separated host suffixes to exclude from the web-search download fallback.
#PAPER_LIBRARY_SEARCH_BLOCKLIST=example.com,badmirror.org
# Discovery circuit breaker: a backend that is rate-limiting this box costs a
# full retry-backoff chain per search term, on every search. After this many
# CONSECUTIVE degraded outcomes the fan-out SKIPS that backend for the cooldown
# window, then calls it again; one success closes the circuit. A skipped backend
# is still reported in sources_degraded, and the fan-out log line names the open
# circuits. Applies to every backend (keyless Semantic Scholar is the usual one).
# 0 = breaker disabled; an unparseable or negative value falls back to the default.
#PAPERVAULT_SEARCH_BREAKER_TRIPS=3
#PAPERVAULT_SEARCH_BREAKER_COOLDOWN_S=3600

# === MCP load control (query / search_papers) ==============================
# Layer 1: heavy calls one MCP session may have EXECUTING at once; its excess
# calls wait on that session's own queue and never count against other sessions.
#PAPERVAULT_SESSION_INFLIGHT=2
# Layer 2: an arriving call is refused with a structured busy answer
# ({"status": "busy", ..., "retry_after_s": N}) when its projected wait,
# (executing calls + 1 - LANES) x rolling average call time, exceeds MAX_WAIT_S.
# 0 disables the refusal. Shipped defaults: LANES=2, MAX_WAIT_S=600.
# A call whose own session already has SESSION_INFLIGHT calls executing is never
# refused: it waits behind its own session and cannot raise the count.
# RECOMMENDED for deployment: LANES=4, MAX_WAIT_S=900 (900 s matches the Codex
# client's tool timeout). A doubled review (2 reviewer clients x 3 calls + 1
# executor x 6 calls = 3 sessions, at most 6 executing) then queues its excess
# calls behind their own sessions; the only calls judged are those taking a
# free session slot, at most (5 executing + 1 - 4) x average = 2 x average, so
# it fits while the rolling average stays at or below 450 s. query p50 is ~4 min
# under load.
#PAPERVAULT_ADMISSION_LANES=4
#PAPERVAULT_ADMISSION_MAX_WAIT_S=900
# Threads for search_papers' external fetch fan-out — a dedicated pool, so a
# search burst cannot starve rerank / embedding / get_paper. 0, negative or
# unparseable falls back to the default.
#PAPERVAULT_SEARCH_FETCH_WORKERS=16
# Longest a (term, backend) fetch waits for a free thread in that pool. Past it
# the fetch is dropped uncalled and that backend reports degraded for the run
# (a hung backend can hold threads well beyond the per-read 30 s timeout). It
# does not feed the circuit breaker. 0, negative or unparseable falls back to
# the default.
#PAPERVAULT_SEARCH_FETCH_QUEUE_TIMEOUT_S=120

# === Acquisition state v2 (slice 1; default off) ===========================
# Gate new acquisitions on retrieval/policy/merge/quarantine and persist
# dimensions on state writes. Old terminals retain unknown policy until a
# separate ruling; campaigns/leases/budgets use the independent REOPEN_V2 flag.
#PAPERVAULT_TERMINAL_V2=1

# === Identity correspondence v2 (slice 2; default off) =====================
# Require resolved DOI/URL correspondence before identity-backfill adoption.
# Contradictions reject one route; unresolved evidence remains retryable.
# Also project domain_status into acquisition policy. Enable TERMINAL_V2 above
# to enforce that policy at download dispatch. No tier reordering or re-open.
#PAPERVAULT_IDENTITY_V2=1

# === Guarded re-open campaigns v2 (slice 3; default off) ==================
# Explicit campaigns only: resolved canonical identity, allowed policy, no
# quarantine, durable budget reservation and generation/lease publication fences.
# Run the bounded CLI in a stopped-service window; see README. Disabling this
# flag does not erase persisted claims, quarantine or spent budgets.
#PAPERVAULT_REOPEN_V2=1

# === API politeness v2 (slice 4; default off) =============================
# Strict shared request windows for Wiley/S2/arXiv. Crossref/Unpaywall/OpenAlex
# are disabled unless an explicit authorized envelope is configured; see README.
#PAPERVAULT_POLITE_V2=1
#PAPERVAULT_POLITE_ENVELOPES={}

# === Identity consolidation v2 (slice 5; default off) ====================
# Persist merge intent, stop claims, verify queue/executor/claim drain, then
# write canonical + alias under the library lock. Expiry stays quarantined;
# operator recovery is required. Persisted fences survive disabling this flag.
#PAPERVAULT_MERGE_V2=1

# === Acquisition stop rules v2 (slice 6; default off) =====================
# Detect duplicate in-flight identity, quota-window violation and mismatched
# publication. Halt campaigns/cool scopes/quarantine; admission refusals are not
# violations. Persisted halts remain effective when this flag is disabled.
#PAPERVAULT_STOPRULES_V2=1

# === Reconcile maintenance toggles (advanced; default off) =================
# Auto-resolve missing (stub) DOIs during reconcile (small identical-title
# false-positive risk; dry-run the audit `--resolve-stub-dois` path first).
#PAPER_PIPELINE_RESOLVE_STUB_DOIS=1
# Reconcile retains records and research assets; routine purge is retired.

# === Grey-zone download tiers (ADR-0004, amended) ==========================
# Shadow libraries + anti-bot scraping. PUBLIC POSTURE (repo is public since
# 2026-08-02): shipped default OFF, strictly opt-in — per the ADR-0004
# amendment's hard gate. Enabling is YOUR legal decision in YOUR jurisdiction;
# install the 'grey' extra (docs/INSTALL.md) and uncomment to opt in.
# (PAPER_PIPELINE_USE_SCIHUB keeps its legacy PAPER_PIPELINE_ name for
# back-compat — no PAPERVAULT_ alias.)
#PAPER_PIPELINE_USE_SCIHUB=1
# Anna's Archive needs a personal member key (inherently opt-in):
#ANNAS_ARCHIVE_API_KEY=

# === Advanced tunables (rarely changed) ====================================
# Optional explicit LLM output-token ceilings (default unset: omitted on the wire so
# Gateway v0.7.3 injects each model's official output ceiling).
#PAPERVAULT_LIB_MAX_TOKENS=
#KS_LLM_MAX_TOKENS=
#KS_SYNTH_MAX_TOKENS=
# Knowledge-store chunking (token target + overlap).
#KS_CHUNK_TOKEN_SIZE=2400
#KS_CHUNK_OVERLAP_TOKEN_SIZE=200
# Redundant second name for the knowledge-store dir (already set by
# PAPERVAULT_STORAGE). Leave UNSET — a value that disagrees with it is a footgun.
#LIGHTRAG_WORKING_DIR=
# Extract micro-timeouts / thresholds.
#PAPER_LIBRARY_EXTRACT_CEILING_SECONDS=1800
#PAPER_LIBRARY_PDF_PROBE_TIMEOUT_SECONDS=30
#PAPER_LIBRARY_LONG_PAPER_PAGE_THRESHOLD=90
#PAPER_LIBRARY_BLANK_CHUNK_FLOOR_CHARS=100
# MinerU HTTP task client: per-request timeout (seconds), then additional endpoint
# attempts for transport failures, with capped exponential backoff. The caller's
# wall-clock deadline also bounds the complete submit/poll/result flow and retries.
#PAPER_LIBRARY_MINERU_HTTP_TIMEOUT=600
#PAPER_LIBRARY_MINERU_INLINE_RETRIES=3
#PAPER_LIBRARY_MINERU_BACKOFF_BASE=1.0
#PAPER_LIBRARY_MINERU_BACKOFF_CAP=30
# Retired caller settings: MINERU_PROCESSING_WINDOW_SIZE and
# PAPER_LIBRARY_MINERU_CLIENT_CLOSE. Rendering belongs to the service and HTTP
# clients always close. PAPER_LIBRARY_MINERU_NATIVE_RETRIES / _NATIVE_BACKOFF
# remain compatibility constants only; they do not control HTTP task retries.
# FD_WARN_FRACTION (default 0.6): warn when the process's open fds cross this fraction of the
#   RLIMIT_NOFILE soft limit (early-warning for an fd/socket leak). 0 disables via the >soft guard.
#PAPER_LIBRARY_FD_WARN_FRACTION=0.6
# Zotero import integration (optional).
#ZOTERO_API_KEY=
#ZOTERO_USER_ID=

# === Catalog authority (P2; authority handoff is separately authorized) =====
# Unset/json retains index.json authority. PostgreSQL never falls back to JSON.
# PAPERVAULT_CATALOG_DSN must be explicit; no credential discovery is performed.
#PAPERVAULT_CATALOG_AUTHORITY=json
#PAPERVAULT_CATALOG_DSN=
#PAPERVAULT_CATALOG_SCHEMA=catalog
#PAPERVAULT_CATALOG_ACTOR=library

# Knowledge implementation selection; default legacy until the operator commits
# a rehearsed, fenced catalog authority handoff. A flag cannot transfer authority.
# postgres requires Postgres library authority and the explicit catalog DSN above.
# See docs/specs/2026-10-20-p4-knowledge-handoff.md. Runtime performs no schema migration.
#PAPERVAULT_KNOWLEDGE_JOBS=legacy
# P5c catalog admission requires fresh protected usage accounting for all new
# intake/execution; verified sealed-receipt recovery still runs when blocked.
# Mode-0600 JSON: scope {vault_root, knowledge_root}, measured_at (ISO timezone),
# backend_bytes including external PG/Neo4j and retained sets outside local roots.
# Refresh within 300 seconds; runtime adds measured catalog relation bytes.
#PAPERVAULT_DERIVATIVE_USAGE_FILE=<explicit operator-owned usage census>
# Positive per-job reservation estimate including scratch/output; default 1 GiB.
#PAPERVAULT_CATALOG_EXECUTION_BYTES=1073741824
