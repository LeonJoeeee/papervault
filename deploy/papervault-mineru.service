# papervault MinerU OCR server — systemd --user unit (template).
#
# Legacy pre-0.10.1 standalone vLLM template, retained for existing deployments.
# It does not expose /tasks and cannot serve the current papervault client.
# Provision the shared official mineru-api service separately (docs/INSTALL.md).
# The shared host deployment historically used mineru.service behind
# mineru-gate.service; that gate owns :30000 and backend stop/start and recovery.
# Do not install this direct-listener template alongside the gate on :30000.
# papervault never manages this unit.
#
# Historical install (legacy VLM consumers only, not current papervault):
#   cp deploy/papervault-mineru.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now papervault-mineru.service
#
# Requires a separately provisioned venv providing `mineru-vllm-server`.
# papervault's HTTP client uses core httpx; [mineru] is an empty compatibility extra.

[Unit]
Description=papervault MinerU2.5 vLLM OCR server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ExecStart runs the independently installed server console script. We go through
# `bash -lc` so your LOGIN shell's PATH resolves `mineru-vllm-server` (e.g. a venv
# activated in ~/.profile / ~/.bashrc). If it is NOT on your login PATH, replace the
# line below with the absolute venv path, e.g.:
#   ExecStart=%h/projects/dev/papervault/.venv/bin/mineru-vllm-server --host 127.0.0.1 --port 30000
ExecStart=/bin/bash -lc 'exec mineru-vllm-server --host 127.0.0.1 --port 30000'
Restart=on-failure
RestartSec=5
# Service timeouts are operator-owned; papervault's HTTP deadline is independent.
# First start pulls the MinerU2.5 weights and loads the model into VRAM.
TimeoutStartSec=300
TimeoutStopSec=60
# Operator-set: pin the OCR server to ONE GPU. Edit the index to the card MinerU should
# own (papervault's embed/reranker default to cuda:0 too — see .env). First run pulls the
# weights from ModelScope by default (MINERU_MODEL_SOURCE).
Environment=CUDA_VISIBLE_DEVICES=0
Environment=MINERU_MODEL_SOURCE=modelscope

[Install]
WantedBy=default.target
