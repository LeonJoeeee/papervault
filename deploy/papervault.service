# papervault unified MCP server — systemd --user unit (deployment #1 / lab posture).
#
# Install:
#   cp deploy/papervault.service ~/.config/systemd/user/
#   # Edit WorkingDirectory and ExecStart below if your clone is not at ~/lab/papervault.
#   systemctl --user daemon-reload && systemctl --user enable --now papervault.service
#
# The service runs the checkout's venv entrypoint with WorkingDirectory at the repo root
# (<repo>, e.g. %h/lab/papervault) so the repo-root .env is loaded (papervault.config loads
# CWD/.env). Pin discipline (ADR-0001): keep the checkout on a release tag, not a moving branch.
# Backing services expected: Postgres + Neo4j (deploy/docker-compose.yml) and shared
# mineru-service exposing official mineru-api /tasks on MINERU_URL (docs/INSTALL.md).

[Unit]
Description=papervault unified MCP server (library + knowledge, streamable-http :8080)
After=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=%h/lab/papervault
ExecStart=%h/lab/papervault/.venv/bin/papervault-mcp --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
LimitNOFILE=65536
# glibc allocator tuning (issue #133), retained as process-start environment settings:
# glibc reads these before papervault loads .env. MALLOC_MMAP_THRESHOLD_ returns >=1 MiB
# allocations to the OS on free; MALLOC_ARENA_MAX=2 bounds per-thread arena RSS bloat.
Environment=MALLOC_MMAP_THRESHOLD_=1048576
Environment=MALLOC_ARENA_MAX=2
# Cap native numerical/tokenizer thread pools to prevent CPU oversubscription under load.
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=RAYON_NUM_THREADS=4
# GPU pinning etc. come from the repo-root .env, not from this unit.
# Reverse proxy Host headers: set PAPERVAULT_MCP_ALLOWED_HOSTS in that .env (docs/INSTALL.md).

[Install]
WantedBy=default.target
